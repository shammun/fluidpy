    "v_theta": "Gamma/(2*pi*r)*(1 - exp(-alpha_w*r**2/(2*nu)))",
    "omega_z": "alpha_w*Gamma/(2*pi*nu)*exp(-alpha_w*r**2/(2*nu))",
    "parameter_map": "alpha_w (Wikipedia) = alpha/2 (our/book axial stretching rate du_z/dz = alpha)",
